    @TestVisible private static void updateField(String fieldName, Object newValue) {
        try {
            ConfiguracaoSistema__c config = [
                SELECT Id, Ambiente__c, Log_Level__c, Log_Ativo__c, 
                        Habilita_Mock__c, Modo_Teste_Ativo__c, 
                        Timeout_Callout__c, Max_Debug_Length__c, Desativar_Flows__c 
                  FROM ConfiguracaoSistema__c
                 ORDER BY CreatedDate DESC LIMIT 1
            ];
            if (config == null) {
                config = new ConfiguracaoSistema__c(SetupOwnerId = UserInfo.getOrganizationId());
            }
            config.put(fieldName, newValue);
            update config;
        } catch (Exception ex) {
            System.debug('⚠️ Failed to update ConfiguracaoSistema__c.' + fieldName + ': ' + ex.getMessage());
        }
    }
